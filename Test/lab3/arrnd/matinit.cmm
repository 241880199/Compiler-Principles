int main()
{
    int a[4][6];
    int i;
    int j;
    a[0][0] = 9;
    a[0][1] = 8;
    i = 0;
    while (i < 3)
    {
        j = 0;
        while (j < 3)
        {
            a[i + 1][j * 2] = (i + 1) * 10 + j * 2;
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < 3)
    {
        j = 0;
        while (j < 3)
        {
            write(a[i + 1][j * 2]);
            j = j + 1;
        }
        i = i + 1;
    }
    write(a[0][0]);
    write(a[0][1]);
    return 0;
}
