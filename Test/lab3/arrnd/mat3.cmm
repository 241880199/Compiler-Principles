int main()
{
    int c[2][2][2];
    int i;
    int j;
    int k;
    i = 0;
    while (i < 2)
    {
        j = 0;
        while (j < 2)
        {
            k = 0;
            while (k < 2)
            {
                c[i][j][k] = i * 4 + j * 2 + k;
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < 2)
    {
        j = 0;
        while (j < 2)
        {
            k = 0;
            while (k < 2)
            {
                write(c[i][j][k]);
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}
