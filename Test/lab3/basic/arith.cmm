int main()
{
    int a;
    int b;
    int c;
    a = 7;
    b = 4;
    c = a + b * 2;
    write(c);
    c = (a + b) * 2;
    write(c);
    c = -a + b;
    write(c);
    c = a * b - a;
    write(c);
    c = 100 - a * b;
    write(c);
    c = a * b / 3;
    write(c);
    c = 20 / 4 / 5;
    write(c);
    c = -(a - b);
    write(c);
    return 0;
}
