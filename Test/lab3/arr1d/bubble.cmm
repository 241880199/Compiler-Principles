int main()
{
    int a[8];
    int i;
    int j;
    int t;
    i = 0;
    while (i < 8)
    {
        a[i] = read();
        i = i + 1;
    }
    i = 0;
    while (i < 8)
    {
        j = 0;
        while (j < 7 - i)
        {
            if (a[j] > a[j + 1])
            {
                t = a[j];
                a[j] = a[j + 1];
                a[j + 1] = t;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < 8)
    {
        write(a[i]);
        i = i + 1;
    }
    return 0;
}
