int sum(int a, int b)
{
    int t;
    t = a;
    if (a > b)
    {
        t = t + b;
    }
    else
    {
        t = t - b;
    }
    while (t <= b)
    {
        t = t - 1;
    }
    return t;
}

int main()
{
    int x;
    int y;
    x = 1;
    y = 2;
    {
        int z;
        z = x + y;
        x = z * 2;
    }
    if (!x)
        x = x - y;
    return 0;
}
